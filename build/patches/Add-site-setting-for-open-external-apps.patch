+    @Override
+    public @ExternalNavigationDelegate.ExternalAppLaunchPolicy int getExternalAppLaunchPolicy(
+            ExternalNavigationParams params) {
+        GURL sourceUrl = GURL.emptyGURL();
+        Origin initiatorOrigin = params.getInitiatorOrigin();
+        if (initiatorOrigin != null && !initiatorOrigin.isOpaque()) {
+            sourceUrl = new GURL(initiatorOrigin.toString());
+        } else if (!params.getReferrerUrl().isEmpty()) {
+            sourceUrl = params.getReferrerUrl();
+        } else if (mTab != null) {
+            sourceUrl = mTab.getUrl();
+        }
+
+        if (sourceUrl.isEmpty()) {
+            return ExternalNavigationDelegate.ExternalAppLaunchPolicy.ASK;
+        }
+
+        Profile profile = mTab.getProfile();
+        @ContentSetting
+        int setting =
+                WebsitePreferenceBridge.getContentSetting(
+                        profile,
+                        ContentSettingsType.OPEN_EXTERNAL_APPS,
+                        sourceUrl,
+                        sourceUrl);
+        switch (setting) {
+            case ContentSetting.ALLOW:
+                return ExternalNavigationDelegate.ExternalAppLaunchPolicy.ALLOW;
+            case ContentSetting.BLOCK:
+                return ExternalNavigationDelegate.ExternalAppLaunchPolicy.BLOCK;
+            case ContentSetting.ASK:
+                return ExternalNavigationDelegate.ExternalAppLaunchPolicy.ASK;
+            default:
+                return ExternalNavigationDelegate.ExternalAppLaunchPolicy.ASK;
+        }
+    }
