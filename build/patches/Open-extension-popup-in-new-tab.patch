From 7c07097fec1e9eb79cbc4bc4941d054ff5a5c605 Mon Sep 17 00:00:00 2001
From: cromite <cromite@users.noreply.github.com>
Date: Sat, 10 Jan 2026 10:30:00 +0000
Subject: [PATCH] Open-extension-popup-in-new-tab

Add a context menu entry (three-dots) in the puzzle-button extensions list to
open the extension action popup page as a full-screen tab.

This is exposed only for `ContextMenuSource::kMenuItem` and only when the
extension action has a popup for the current tab.

License: GPL-2.0-or-later - https://spdx.org/licenses/GPL-2.0-or-later.html
FILE:Open-extension-popup-in-new-tab.patch
---
--- a/chrome/browser/extensions/extension_context_menu_model.h
+++ b/chrome/browser/extensions/extension_context_menu_model.h
@@ -63,6 +63,7 @@
     VIEW_WEB_PERMISSIONS,
     POLICY_INSTALLED,
     TOGGLE_SIDE_PANEL_VISIBILITY,
+    OPEN_POPUP_IN_NEW_TAB,
     // NOTE: If you update this, you probably need to update the
     // ContextMenuAction enum below.
   };
@@ -91,7 +92,8 @@
     kViewWebPermissions = 13,
     kPolicyInstalled = 14,
     kToggleSidePanelVisibility = 15,
-    kMaxValue = kToggleSidePanelVisibility,
+    kOpenPopupInNewTab = 16,
+    kMaxValue = kOpenPopupInNewTab,
     // NOTE: Please update ExtensionContextMenuAction in enums.xml if you modify
     // this enum.
   };

--- a/chrome/browser/extensions/extension_context_menu_model.cc
+++ b/chrome/browser/extensions/extension_context_menu_model.cc
@@ -184,6 +184,8 @@
       return ContextMenuAction::kManageExtensions;
     case ExtensionContextMenuModel::INSPECT_POPUP:
       return ContextMenuAction::kInspectPopup;
+    case ExtensionContextMenuModel::OPEN_POPUP_IN_NEW_TAB:
+      return ContextMenuAction::kOpenPopupInNewTab;
     case ExtensionContextMenuModel::PAGE_ACCESS_RUN_ON_CLICK:
       return ContextMenuAction::kPageAccessRunOnClick;
     case ExtensionContextMenuModel::PAGE_ACCESS_RUN_ON_SITE:
@@ -405,6 +407,18 @@
   if (ContextMenuMatcher::IsExtensionsCustomCommandId(command_id))
     return extension_items_->IsCommandIdVisible(command_id);
 
+  if (command_id == OPEN_POPUP_IN_NEW_TAB) {
+    if (source_ != ContextMenuSource::kMenuItem) {
+      return false;
+    }
+    content::WebContents* web_contents = GetActiveWebContents();
+    if (!web_contents || !extension_action_) {
+      return false;
+    }
+    int tab_id = ExtensionTabUtil::GetTabId(web_contents);
+    return extension_action_->HasPopup(tab_id);
+  }
+
   // Items added by Chrome to the menu are always visible.
   return true;
 }
@@ -473,6 +487,17 @@
     case MANAGE_EXTENSIONS:
     case VIEW_WEB_PERMISSIONS:
       return true;
+    case OPEN_POPUP_IN_NEW_TAB: {
+      if (source_ != ContextMenuSource::kMenuItem) {
+        return false;
+      }
+      content::WebContents* web_contents = GetActiveWebContents();
+      if (!web_contents || !extension_action_) {
+        return false;
+      }
+      int tab_id = ExtensionTabUtil::GetTabId(web_contents);
+      return extension_action_->HasPopup(tab_id);
+    }
     default:
       NOTREACHED() << "Unknown command" << command_id;
   }
@@ -572,6 +597,19 @@
       NOTIMPLEMENTED();
 #endif
       break;
+    case OPEN_POPUP_IN_NEW_TAB: {
+      content::WebContents* web_contents = GetActiveWebContents();
+      if (!web_contents || !extension_action_) {
+        return;
+      }
+      GURL popup_url =
+          extension_action_->GetPopupUrl(ExtensionTabUtil::GetTabId(web_contents));
+      if (popup_url.is_empty()) {
+        return;
+      }
+      OpenUrl(web_contents, popup_url);
+      break;
+    }
     case INSPECT_POPUP: {
       delegate_->InspectPopup();
       break;
@@ -830,6 +868,9 @@
     AddItemWithStringId(UNINSTALL, IDS_EXTENSIONS_UNINSTALL);
   }
 
+  AddItemWithStringId(OPEN_POPUP_IN_NEW_TAB,
+                      IDS_EXTENSION_ACTION_OPEN_POPUP_IN_NEW_TAB);
+
 #if !BUILDFLAG(IS_ANDROID)
   AddSidePanelEntryIfPresent(*extension);
 #endif
@@ -893,6 +934,9 @@
   if (OptionsPageInfo::HasOptionsPage(extension))
     AddItemWithStringId(OPTIONS, IDS_EXTENSIONS_OPTIONS_MENU_ITEM);
 
+  AddItemWithStringId(OPEN_POPUP_IN_NEW_TAB,
+                      IDS_EXTENSION_ACTION_OPEN_POPUP_IN_NEW_TAB);
+
   if (!is_component_) {
     if (IsExtensionRequiredByPolicy(extension, profile_)) {
       // TODO (kylixrd): Investigate the usage of the hard-coded color.

--- a/chrome/app/generated_resources.grd
+++ b/chrome/app/generated_resources.grd
@@ -5967,6 +5967,9 @@
           <message name="IDS_VIEW_WEB_PERMISSIONS" desc="The text for the button in the extension context menu used to open the chrome://settings/content/siteDetails?site=xxx page and view the site details for a specific extension (sentence case).">
             View web permissions
           </message>
+          <message name="IDS_EXTENSION_ACTION_OPEN_POPUP_IN_NEW_TAB" desc="The text for the context menu item that opens the extension action popup page in a new tab (sentence case).">
+            Open popup in new tab
+          </message>
           <message name="IDS_EXTENSION_ACTION_INSPECT_POPUP" desc="The text for the right-click menu of page and browser actions which shows the popup and opens the developer tools (sentence case).">
             Inspect popup
           </message>
@@ -6041,6 +6044,9 @@
           <message name="IDS_VIEW_WEB_PERMISSIONS" desc="The text for the button in the extension context menu used to open the chrome://settings/content/siteDetails?site=xxx page and view the site details for a specific extension (title case).">
             View Web Permissions
           </message>
+          <message name="IDS_EXTENSION_ACTION_OPEN_POPUP_IN_NEW_TAB" desc="The text for the context menu item that opens the extension action popup page in a new tab (title case).">
+            Open Popup in New Tab
+          </message>
           <message name="IDS_EXTENSION_ACTION_INSPECT_POPUP" desc="The text for the right-click menu of page and browser actions which shows the popup and opens the developer tools (title case).">
             Inspect Popup
           </message>

--- a/tools/metrics/histograms/metadata/extensions/enums.xml
+++ b/tools/metrics/histograms/metadata/extensions/enums.xml
@@ -119,6 +119,7 @@
   <int value="13" label="kViewWebPermissions"/>
   <int value="14" label="kPolicyInstalled"/>
   <int value="15" label="kToggleSidePanelVisibility"/>
+  <int value="16" label="kOpenPopupInNewTab"/>
 </enum>
 
