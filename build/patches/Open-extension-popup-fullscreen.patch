+import org.chromium.ui.base.WindowAndroid;
+
+/** Displays an extension action popup page as a fullscreen dialog, while keeping tab context. */
+@NullMarked
+class ExtensionActionFullscreenPopup implements Destroyable {
+    private final String mActionId;
+    private final String mTitle;
+    private final boolean mShowToolbarOnTop;
+    private final ExtensionActionPopupContents mContents;
+    private final ThinWebView mThinWebView;
+    private final ChromeDialog mDialog;
+
+    private boolean mDestroyed;
+
+    ExtensionActionFullscreenPopup(
+            Activity activity,
+            WindowAndroid windowAndroid,
+            String actionId,
+            String title,
+            boolean showToolbarOnTop,
+            ExtensionActionPopupContents contents) {
+        mActionId = actionId;
+        mTitle = title;
+        mShowToolbarOnTop = showToolbarOnTop;
+        mContents = contents;
+
+        WebContents webContents = contents.getWebContents();
+
+        ContentView contentView = ContentView.createContentView(activity, webContents);
+
+        webContents.setDelegates(
+                VersionInfo.getProductVersion(),
+                ViewAndroidDelegate.createBasicDelegate(contentView),
+                contentView,
+                windowAndroid,
+                WebContents.createDefaultInternalsHolder());
+
+        mThinWebView =
+                ThinWebViewFactory.create(
+                        activity,
+                        new ThinWebViewConstraints(),
+                        NullUtil.assumeNonNull(windowAndroid.getIntentRequestTracker()));
+        mThinWebView.attachWebContents(webContents, contentView, null);
+
+        GestureListenerManager gestureListenerManager =
+                GestureListenerManager.fromWebContents(webContents);
+        if (gestureListenerManager != null) {
+            gestureListenerManager.updateMultiTouchZoomSupport(true);
+            gestureListenerManager.updateDoubleTapSupport(true);
+        }
+
+        mDialog =
+                new ChromeDialog(
+                        activity,
+                        org.chromium.components.browser_ui.widget.R.style
+                                .ThemeOverlay_BrowserUI_Fullscreen,
+                        EdgeToEdgeUtils.isEdgeToEdgeEverywhereEnabled());
+
+        int toolbarHeightPx = ViewUtils.dpToPx(activity, 48);
+
+        Toolbar toolbar = new Toolbar(activity);
+        toolbar.setTitle(mTitle);
+        toolbar.setNavigationIcon(org.chromium.ui.R.drawable.ic_arrow_back_24dp);
+        toolbar.setNavigationOnClickListener((View v) -> mDialog.dismiss());
+
+        FrameLayout webContentsContainer = new FrameLayout(activity);
+        webContentsContainer.addView(
+                mThinWebView.getView(),
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.MATCH_PARENT));
+
+        LinearLayout container = new LinearLayout(activity);
+        container.setOrientation(LinearLayout.VERTICAL);
+        LinearLayout.LayoutParams toolbarLayoutParams =
+                new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, toolbarHeightPx);
+        LinearLayout.LayoutParams webContentsLayoutParams =
+                new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1.0f);
+        if (mShowToolbarOnTop) {
+            container.addView(toolbar, toolbarLayoutParams);
+            container.addView(webContentsContainer, webContentsLayoutParams);
+        } else {
+            container.addView(webContentsContainer, webContentsLayoutParams);
+            container.addView(toolbar, toolbarLayoutParams);
+        }
+
+        mDialog.setContentView(container);
+        mDialog.setOnDismissListener((ignored) -> destroy());
+
+        contents.setDelegate(new ContentsDelegate());
+    }
+
+    String getActionId() {
+        return mActionId;
+    }
+
+    void show() {
+        if (mDestroyed) return;
+        mDialog.show();
+    }
+
+    void loadInitialPage() {
+        if (mDestroyed) return;
+        mContents.loadInitialPage();
+    }
+
+    @Override
+    public void destroy() {
+        if (mDestroyed) return;
+        mDestroyed = true;
+
+        mDialog.dismiss();
+        mThinWebView.destroy();
+        mContents.destroy();
+    }
+
+    private class ContentsDelegate implements ExtensionActionPopupContents.Delegate {
+        @Override
+        public void resizeDueToAutoResize(int width, int height) {}
+
+        @Override
+        public void onLoaded() {}
+
+        @Override
+        public void onClose() {
+            mDialog.dismiss();
+        }
+    }
+}
