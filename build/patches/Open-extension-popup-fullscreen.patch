+
+    private void maybeAddOpenPopupFullscreenMenuItem(String actionId, ModelList modelList) {
+        ExtensionActionsBridge extensionActionsBridge =
+                mExtensionActionsUpdateHelper.getExtensionActionsBridge();
+        Tab currentTab = mExtensionActionsUpdateHelper.getCurrentTab();
+        if (extensionActionsBridge == null || currentTab == null) {
+            return;
+        }
+
+        int tabId = currentTab.getId();
+        if (!extensionActionsBridge.actionHasPopup(actionId, tabId)) {
+            return;
+        }
+
+        modelList.add(new ListItem(ListItemType.DIVIDER, new PropertyModel()));
+        modelList.add(
+                new ListItem(
+                        ListItemType.MENU_ITEM,
+                        new PropertyModel.Builder(ListMenuItemProperties.ALL_KEYS)
+                                .with(
+                                        ListMenuItemProperties.TITLE,
+                                        mContext.getString(
+                                                org.chromium.chrome.browser.ui.extensions.R
+                                                        .string
+                                                        .extension_action_open_popup_fullscreen))
+                                .with(ListMenuItemProperties.ENABLED, true)
+                                .with(
+                                        ListMenuItemProperties.CLICK_LISTENER,
+                                        (view) -> openPopupFullscreen(actionId))
+                                .build()));
+    }
+
+    private void openPopupFullscreen(String actionId) {
+        closeFullscreenPopup();
+
+        Tab currentTab = mExtensionActionsUpdateHelper.getCurrentTab();
+        if (currentTab == null) {
+            return;
+        }
+
+        ExtensionActionsBridge extensionActionsBridge =
+                mExtensionActionsUpdateHelper.getExtensionActionsBridge();
+        if (extensionActionsBridge == null) {
+            return;
+        }
+
+        Context tabContext = currentTab.getContext();
+        if (!(tabContext instanceof Activity)) {
+            return;
+        }
+
+        WindowAndroid windowAndroid = currentTab.getWindowAndroid();
+        if (windowAndroid == null) {
+            return;
+        }
+
+        ChromeAndroidTask task = mTaskSupplier.apply(currentTab);
+        if (task == null) {
+            return;
+        }
+
+        ExtensionActionPopupContents contents =
+                ExtensionActionPopupContents.create(
+                        task, actionId, currentTab.getId(), /*enableAutoResize=*/false);
+        if (contents == null) {
+            return;
+        }
+
+        boolean showToolbarOnTop = AddressBarPreference.isToolbarConfiguredToShowOnTop();
+
+        int tabId = currentTab.getId();
+        String title = "";
+        ExtensionAction action = extensionActionsBridge.getAction(actionId, tabId);
+        if (action != null) {
+            title = action.getTitle();
+        }
+
+        mCurrentFullscreenPopup =
+                new ExtensionActionFullscreenPopup(
+                        (Activity) tabContext,
+                        windowAndroid,
+                        actionId,
+                        title,
+                        showToolbarOnTop,
+                        contents);
+        mCurrentFullscreenPopup.show();
+        mCurrentFullscreenPopup.loadInitialPage();
+    }
+
+    private void closeFullscreenPopup() {
+        if (mCurrentFullscreenPopup == null) {
+            return;
+        }
+        ExtensionActionFullscreenPopup popup = mCurrentFullscreenPopup;
+        mCurrentFullscreenPopup = null;
+        popup.destroy();
+    }
