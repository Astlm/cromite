+TEST_F(WebGPUContextLostTest, WgslLanguageFeaturesFollowSiteSettings) {
+  base::test::ScopedFeatureList scoped_feature_list;
+  scoped_feature_list.InitAndEnableFeature(::features::kWebGPUService);
+
+  V8TestingScope v8_test_scope;
+  auto [execution_context, gpu] = SetUpGPU(&v8_test_scope);
+  ASSERT_NE(nullptr, execution_context);
+  auto* web_frame = WebLocalFrameImpl::FromFrame(page_->GetFrame());
+
+  TestContentSettingsClient blocked_client(false);
+  web_frame->SetContentSettingsClient(&blocked_client);
+  EXPECT_EQ(nullptr, gpu->wgslLanguageFeatures());
+
+  TestContentSettingsClient allowed_client(true);
+  web_frame->SetContentSettingsClient(&allowed_client);
+  EXPECT_NE(nullptr, gpu->wgslLanguageFeatures());
+
+  web_frame->SetContentSettingsClient(nullptr);
+}
+
+TEST_F(WebGPUContextLostTest, RequestAdapterBlockedBySiteSettings) {
+  base::test::ScopedFeatureList scoped_feature_list;
+  scoped_feature_list.InitAndEnableFeature(::features::kWebGPUService);
+
+  V8TestingScope v8_test_scope;
+  auto [execution_context, gpu] = SetUpGPU(&v8_test_scope);
+  ASSERT_NE(nullptr, execution_context);
+  auto* web_frame = WebLocalFrameImpl::FromFrame(page_->GetFrame());
+
+  TestContentSettingsClient blocked_client(false);
+  web_frame->SetContentSettingsClient(&blocked_client);
+
+  auto* options = GPURequestAdapterOptions::Create();
+  ScriptPromiseTester tester(v8_test_scope.GetScriptState(),
+                             gpu->requestAdapter(
+                                 v8_test_scope.GetScriptState(), options));
+  tester.WaitUntilSettled();
+
+  EXPECT_TRUE(tester.IsFulfilled());
+  EXPECT_TRUE(tester.Value().V8Value()->IsNull());
+
+  web_frame->SetContentSettingsClient(nullptr);
+}
