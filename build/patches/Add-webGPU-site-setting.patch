+class TestContentSettingsClient final : public WebContentSettingsClient {
+ public:
+  explicit TestContentSettingsClient(bool allow_webgpu)
+      : allow_webgpu_(allow_webgpu) {}
+
+  bool AllowContentSetting(ContentSettingsType type,
+                           bool enabled_per_settings) override {
+    if (type == ContentSettingsType::WEBGPU) {
+      return allow_webgpu_;
+    }
+    return enabled_per_settings;
+  }
+
+ private:
+  const bool allow_webgpu_;
+};
