From 61722122ae64eb9f6287802eacd520b79834bf6a Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 10 Apr 2026 15:18:15 +0800
Subject: [PATCH] Stop forcing WebGPU off globally

---
 content/child/runtime_features.cc | 1 -
 gpu/config/gpu_finch_features.cc  | 2 +-
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/content/child/runtime_features.cc b/content/child/runtime_features.cc
index 9c4b6c67e0..dd0d4a9131 100644
--- a/content/child/runtime_features.cc
+++ b/content/child/runtime_features.cc
@@ -556,7 +556,6 @@ void SetCustomizedRuntimeFeaturesFromCombinedArgs(
 
   WebRuntimeFeatures::EnableRemotePlayback(false);
 
-  WebRuntimeFeatures::EnableFeatureFromString("WebGpu", false);
 
   WebRuntimeFeatures::EnableBackForwardCache(
       content::IsBackForwardCacheEnabled());
diff --git a/gpu/config/gpu_finch_features.cc b/gpu/config/gpu_finch_features.cc
index 53f29e3158..16d98ea608 100644
--- a/gpu/config/gpu_finch_features.cc
+++ b/gpu/config/gpu_finch_features.cc
@@ -182,7 +182,7 @@ BASE_FEATURE(kEnableDrDc,
 // enabled by default on supported platforms.
 #if BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_WIN) || BUILDFLAG(IS_CHROMEOS) || \
     BUILDFLAG(IS_ANDROID)
-#define WEBGPU_ENABLED base::FEATURE_DISABLED_BY_DEFAULT
+#define WEBGPU_ENABLED base::FEATURE_ENABLED_BY_DEFAULT
 #else
 #define WEBGPU_ENABLED base::FEATURE_DISABLED_BY_DEFAULT
 #endif
-- 
